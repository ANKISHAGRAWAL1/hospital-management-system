const mongoose = require("mongoose");

const Appointment = require("../models/Appointment");
const Doctor = require("../models/Doctor");
const Department = require("../models/Departments");

// ======================================================
// CONSTANTS
// ======================================================

const VALID_APPOINTMENT_TYPES = ["hospital", "video"];
const VALID_DURATIONS = [15, 30, 45, 60];

const ACTIVE_APPOINTMENT_STATUSES = {
  $nin: ["cancelled", "no-show"],
};

// ======================================================
// HELPERS
// ======================================================

const timeToMinutes = (time) => {
  if (typeof time !== "string") {
    return NaN;
  }

  const value = time.trim();

  if (!/^\d{2}:\d{2}$/.test(value)) {
    return NaN;
  }

  const [hours, minutes] = value.split(":").map(Number);

  if (
    !Number.isInteger(hours) ||
    !Number.isInteger(minutes) ||
    hours < 0 ||
    hours > 23 ||
    minutes < 0 ||
    minutes > 59
  ) {
    return NaN;
  }

  return hours * 60 + minutes;
};

const minutesToTime = (minutes) => {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;

  return `${String(hours).padStart(2, "0")}:${String(mins).padStart(
    2,
    "0"
  )}`;
};

const isValidTime = (time) => {
  return (
    typeof time === "string" &&
    /^([01]\d|2[0-3]):([0-5]\d)$/.test(time.trim())
  );
};

const normalizeId = (value) => {
  if (!value) {
    return null;
  }

  if (value._id) {
    return value._id.toString();
  }

  return value.toString();
};

const isValidDuration = (duration) => {
  return VALID_DURATIONS.includes(Number(duration));
};

// ======================================================
// DATE HELPER
// ======================================================

const parseAppointmentDate = (value) => {
  if (!value) {
    return null;
  }

  if (value instanceof Date) {
    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return null;
    }

    date.setHours(0, 0, 0, 0);

    return date;
  }

  const stringValue = String(value).trim();

  const match = stringValue.match(/^(\d{4})-(\d{2})-(\d{2})$/);

  if (match) {
    const year = Number(match[1]);
    const month = Number(match[2]) - 1;
    const day = Number(match[3]);

    const date = new Date(year, month, day);

    if (
      date.getFullYear() !== year ||
      date.getMonth() !== month ||
      date.getDate() !== day
    ) {
      return null;
    }

    date.setHours(0, 0, 0, 0);

    return date;
  }

  const date = new Date(stringValue);

  if (Number.isNaN(date.getTime())) {
    return null;
  }

  date.setHours(0, 0, 0, 0);

  return date;
};

// ======================================================
// GET DAY NAME
// ======================================================

const getDayName = (date) => {
  return date.toLocaleDateString("en-US", {
    weekday: "long",
  });
};

// ======================================================
// GET APPOINTMENT TYPE AVAILABILITY
// ======================================================

const getTypeAvailability = (availability, appointmentType) => {
  if (!availability) {
    return null;
  }

  if (appointmentType === "hospital") {
    return availability.hospital || null;
  }

  if (appointmentType === "video") {
    return availability.video || null;
  }

  return null;
};

// ======================================================
// GENERATE APPOINTMENT SLOTS
// ======================================================

const generateSlots = (
  startTime,
  endTime,
  appointmentDuration
) => {
  const slots = [];

  if (!isValidTime(startTime) || !isValidTime(endTime)) {
    return slots;
  }

  const duration = Number(appointmentDuration);

  if (!isValidDuration(duration)) {
    return slots;
  }

  const startMinutes = timeToMinutes(startTime);
  const endMinutes = timeToMinutes(endTime);

  if (
    !Number.isFinite(startMinutes) ||
    !Number.isFinite(endMinutes) ||
    startMinutes >= endMinutes
  ) {
    return slots;
  }

  let current = startMinutes;

  while (current + duration <= endMinutes) {
    const slotStart = current;
    const slotEnd = current + duration;

    slots.push({
      id: `${minutesToTime(slotStart)}-${minutesToTime(slotEnd)}`,
      startTime: minutesToTime(slotStart),
      endTime: minutesToTime(slotEnd),
    });

    current += duration;
  }

  return slots;
};

// ======================================================
// GET DOCTOR AVAILABILITY FOR DATE
// ======================================================

const getDoctorSlotsForDate = ({
  doctor,
  appointmentDate,
  appointmentType,
}) => {
  const dayName = getDayName(appointmentDate);

  const availability = Array.isArray(doctor.availability)
    ? doctor.availability.find(
        (item) => item?.day?.toLowerCase() === dayName.toLowerCase()
      )
    : null;

  if (!availability) {
    return {
      dayName,
      availability: null,
      typeAvailability: null,
      slots: [],
    };
  }

  const typeAvailability = getTypeAvailability(
    availability,
    appointmentType
  );

  if (!typeAvailability || typeAvailability.enabled !== true) {
    return {
      dayName,
      availability,
      typeAvailability,
      slots: [],
    };
  }

  const appointmentDuration = Number(
    doctor.appointmentDuration
  );

  if (!isValidDuration(appointmentDuration)) {
    return {
      dayName,
      availability,
      typeAvailability,
      slots: [],
    };
  }

  const slots = [];

  const workingSlots = Array.isArray(typeAvailability.slots)
    ? typeAvailability.slots
    : [];

  for (const workingSlot of workingSlots) {
    if (
      !workingSlot?.startTime ||
      !workingSlot?.endTime
    ) {
      continue;
    }

    const generatedSlots = generateSlots(
      workingSlot.startTime,
      workingSlot.endTime,
      appointmentDuration
    );

    slots.push(...generatedSlots);
  }

  return {
    dayName,
    availability,
    typeAvailability,
    slots,
  };
};

// ======================================================
// CHECK WHETHER SELECTED SLOT IS VALID
// ======================================================

const validateSelectedSlot = ({
  typeAvailability,
  startMinutes,
  endMinutes,
  appointmentDuration,
}) => {
  const workingSlots = Array.isArray(typeAvailability?.slots)
    ? typeAvailability.slots
    : [];

  const workingSlot = workingSlots.find((slot) => {
    if (
      !isValidTime(slot?.startTime) ||
      !isValidTime(slot?.endTime)
    ) {
      return false;
    }

    const workingStart = timeToMinutes(slot.startTime);
    const workingEnd = timeToMinutes(slot.endTime);

    return (
      startMinutes >= workingStart &&
      endMinutes <= workingEnd
    );
  });

  if (!workingSlot) {
    return {
      valid: false,
      message:
        "Selected time slot is outside doctor's available hours",
    };
  }

  const workingStartMinutes = timeToMinutes(
    workingSlot.startTime
  );

  const offset =
    startMinutes - workingStartMinutes;

  if (
    offset < 0 ||
    offset % appointmentDuration !== 0
  ) {
    return {
      valid: false,
      message:
        "Selected time is not a valid appointment slot",
    };
  }

  return {
    valid: true,
    workingSlot,
  };
};

// ======================================================
// FIND OVERLAPPING APPOINTMENT
// ======================================================

const findExistingAppointment = async ({
  doctorId,
  departmentId,
  appointmentType,
  appointmentDate,
  startTime,
  endTime,
}) => {
  return Appointment.findOne({
    doctor: doctorId,
    department: departmentId,
    appointmentType,
    appointmentDate,
    status: ACTIVE_APPOINTMENT_STATUSES,
    startTime: {
      $lt: endTime,
    },
    endTime: {
      $gt: startTime,
    },
  });
};

// ======================================================
// CREATE APPOINTMENT RECORD
// ======================================================

const createAppointmentRecord = async ({
  patientId,
  doctor,
  department,
  appointmentType,
  appointmentDate,
  startTime,
  endTime,
  status = "pending",
  paymentStatus = "unpaid",
}) => {
  // --------------------------------------------------
  // 1. REQUIRED FIELDS
  // --------------------------------------------------

  if (
    !patientId ||
    !doctor ||
    !department ||
    !appointmentType ||
    !appointmentDate ||
    !startTime ||
    !endTime
  ) {
    throw new Error(
      "Doctor, department, appointment type, date and time slot are required"
    );
  }

  // --------------------------------------------------
  // 2. NORMALIZE IDS
  // --------------------------------------------------

  const normalizedPatientId = normalizeId(patientId);
  const normalizedDoctorId = normalizeId(doctor);
  const normalizedDepartmentId = normalizeId(department);

  // --------------------------------------------------
  // 3. VALIDATE APPOINTMENT TYPE
  // --------------------------------------------------

  if (!VALID_APPOINTMENT_TYPES.includes(appointmentType)) {
    throw new Error(
      "Appointment type must be hospital or video"
    );
  }

  // --------------------------------------------------
  // 4. VALIDATE PAYMENT STATUS
  // --------------------------------------------------

  const validPaymentStatuses = [
    "unpaid",
    "pending",
    "paid",
    "failed",
    "refunded",
  ];

  if (!validPaymentStatuses.includes(paymentStatus)) {
    throw new Error("Invalid payment status");
  }

  // --------------------------------------------------
  // 5. VALIDATE PATIENT ID
  // --------------------------------------------------

  if (!mongoose.isValidObjectId(normalizedPatientId)) {
    throw new Error("Invalid patient ID");
  }

  // --------------------------------------------------
  // 6. VALIDATE DOCTOR ID
  // --------------------------------------------------

  if (!mongoose.isValidObjectId(normalizedDoctorId)) {
    throw new Error("Invalid doctor ID");
  }

  // --------------------------------------------------
  // 7. VALIDATE DEPARTMENT ID
  // --------------------------------------------------

  if (!mongoose.isValidObjectId(normalizedDepartmentId)) {
    throw new Error("Invalid department ID");
  }

  // --------------------------------------------------
  // 8. APPOINTMENT DATE
  // --------------------------------------------------

  const selectedDate = parseAppointmentDate(
    appointmentDate
  );

  if (!selectedDate) {
    throw new Error("Invalid appointment date");
  }

  const today = new Date();

  today.setHours(0, 0, 0, 0);

  if (selectedDate < today) {
    throw new Error(
      "Appointment date cannot be in the past"
    );
  }

  // --------------------------------------------------
  // 9. FIND DOCTOR
  // --------------------------------------------------

  const doctorData = await Doctor.findById(
    normalizedDoctorId
  );

  if (!doctorData) {
    throw new Error("Doctor not found");
  }

  // --------------------------------------------------
  // 10. DOCTOR STATUS
  // --------------------------------------------------

  if (!doctorData.status) {
    throw new Error(
      "Selected doctor is currently unavailable"
    );
  }

  // --------------------------------------------------
  // 11. FIND DEPARTMENT
  // --------------------------------------------------

  const departmentData = await Department.findById(
    normalizedDepartmentId
  );

  if (!departmentData) {
    throw new Error("Department not found");
  }

  // --------------------------------------------------
  // 12. DEPARTMENT STATUS
  // --------------------------------------------------

  if (!departmentData.status) {
    throw new Error(
      "Selected department is currently unavailable"
    );
  }

  // --------------------------------------------------
  // 13. DOCTOR-DEPARTMENT CHECK
  // --------------------------------------------------

  if (
    !doctorData.department ||
    normalizeId(doctorData.department) !==
      normalizeId(departmentData._id)
  ) {
    throw new Error(
      "Selected doctor does not belong to this department"
    );
  }

  // --------------------------------------------------
  // 14. TIME FORMAT
  // --------------------------------------------------

  if (
    !isValidTime(startTime) ||
    !isValidTime(endTime)
  ) {
    throw new Error(
      "Time must be in HH:mm format"
    );
  }

  const normalizedStartTime = startTime.trim();
  const normalizedEndTime = endTime.trim();

  // --------------------------------------------------
  // 15. CONVERT TIME
  // --------------------------------------------------

  const startMinutes = timeToMinutes(
    normalizedStartTime
  );

  const endMinutes = timeToMinutes(
    normalizedEndTime
  );

  // --------------------------------------------------
  // 16. TIME ORDER
  // --------------------------------------------------

  if (startMinutes >= endMinutes) {
    throw new Error(
      "End time must be after start time"
    );
  }

  // --------------------------------------------------
  // 17. APPOINTMENT DURATION
  // --------------------------------------------------

  const appointmentDuration = Number(
    doctorData.appointmentDuration
  );

  if (!isValidDuration(appointmentDuration)) {
    throw new Error(
      "Doctor appointment duration is not configured correctly"
    );
  }

  // --------------------------------------------------
  // 18. SELECTED SLOT DURATION
  // --------------------------------------------------

  const selectedDuration =
    endMinutes - startMinutes;

  if (
    selectedDuration !==
    appointmentDuration
  ) {
    throw new Error(
      `Appointment duration must be ${appointmentDuration} minutes`
    );
  }

  // --------------------------------------------------
  // 19. DAY AVAILABILITY
  // --------------------------------------------------

  const dayName = getDayName(selectedDate);

  const availability = Array.isArray(
    doctorData.availability
  )
    ? doctorData.availability.find(
        (item) =>
          item?.day?.toLowerCase() ===
          dayName.toLowerCase()
      )
    : null;

  if (!availability) {
    throw new Error(
      `Doctor is not available on ${dayName}`
    );
  }

  // --------------------------------------------------
  // 20. TYPE AVAILABILITY
  // --------------------------------------------------

  const typeAvailability =
    getTypeAvailability(
      availability,
      appointmentType
    );

  if (!typeAvailability?.enabled) {
    throw new Error(
      `Doctor does not provide ${appointmentType} consultation on ${dayName}`
    );
  }

  // --------------------------------------------------
  // 21. VALIDATE SLOT
  // --------------------------------------------------

  const slotValidation =
    validateSelectedSlot({
      typeAvailability,
      startMinutes,
      endMinutes,
      appointmentDuration,
    });

  if (!slotValidation.valid) {
    throw new Error(
      slotValidation.message
    );
  }

  // --------------------------------------------------
  // 22. CHECK EXISTING APPOINTMENT
  // --------------------------------------------------

  const existingAppointment =
    await findExistingAppointment({
      doctorId: normalizedDoctorId,
      departmentId: normalizedDepartmentId,
      appointmentType,
      appointmentDate: selectedDate,
      startTime: normalizedStartTime,
      endTime: normalizedEndTime,
    });

  if (existingAppointment) {
    const error = new Error(
      "This appointment slot is already booked. Please select another available time."
    );

    error.statusCode = 409;

    throw error;
  }

  // --------------------------------------------------
  // 23. CREATE APPOINTMENT
  // --------------------------------------------------

  const appointment =
    await Appointment.create({
      patient: normalizedPatientId,
      doctor: normalizedDoctorId,
      department: normalizedDepartmentId,
      appointmentType,
      appointmentDate: selectedDate,
      startTime: normalizedStartTime,
      endTime: normalizedEndTime,
      consultationFee:
        Number(doctorData.consultationFee) || 0,
      status,
      paymentStatus,
    });

  // --------------------------------------------------
  // 24. POPULATE
  // --------------------------------------------------

  const createdAppointment =
    await Appointment.findById(
      appointment._id
    )
      .populate(
        "doctor",
        "firstName lastName name specialization profileImage consultationFee appointmentDuration"
      )
      .populate(
        "department",
        "name code"
      )
      .populate(
        "patient",
        "name email phone"
      );

  return createdAppointment;
};

// ======================================================
// GET AVAILABLE APPOINTMENT SLOTS
// ======================================================

const getAvailableAppointmentSlots = async (
  req,
  res
) => {
  try {
    const {
      doctor,
      department,
      appointmentType,
      appointmentDate,
    } = req.query;

    // --------------------------------------------------
    // 1. REQUIRED FIELDS
    // --------------------------------------------------

    if (
      !doctor ||
      !department ||
      !appointmentType ||
      !appointmentDate
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Doctor, department, appointment type and appointment date are required",
      });
    }

    // --------------------------------------------------
    // 2. APPOINTMENT TYPE
    // --------------------------------------------------

    if (
      !VALID_APPOINTMENT_TYPES.includes(
        appointmentType
      )
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Appointment type must be hospital or video",
      });
    }

    // --------------------------------------------------
    // 3. DOCTOR ID
    // --------------------------------------------------

    if (
      !mongoose.isValidObjectId(doctor)
    ) {
      return res.status(400).json({
        success: false,
        message: "Invalid doctor ID",
      });
    }

    // --------------------------------------------------
    // 4. DEPARTMENT ID
    // --------------------------------------------------

    if (
      !mongoose.isValidObjectId(
        department
      )
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Invalid department ID",
      });
    }

    // --------------------------------------------------
    // 5. DATE
    // --------------------------------------------------

    const selectedDate =
      parseAppointmentDate(
        appointmentDate
      );

    if (!selectedDate) {
      return res.status(400).json({
        success: false,
        message:
          "Invalid appointment date",
      });
    }

    // --------------------------------------------------
    // 6. PAST DATE
    // --------------------------------------------------

    const today = new Date();

    today.setHours(0, 0, 0, 0);

    if (selectedDate < today) {
      return res.status(400).json({
        success: false,
        message:
          "Appointment date cannot be in the past",
      });
    }

    // --------------------------------------------------
    // 7. GET DOCTOR
    // --------------------------------------------------

    const doctorData =
      await Doctor.findById(
        doctor
      ).lean();

    if (!doctorData) {
      return res.status(404).json({
        success: false,
        message: "Doctor not found",
      });
    }

    // --------------------------------------------------
    // 8. DOCTOR STATUS
    // --------------------------------------------------

    if (!doctorData.status) {
      return res.status(400).json({
        success: false,
        message:
          "Selected doctor is currently unavailable",
      });
    }

    // --------------------------------------------------
    // 9. GET DEPARTMENT
    // --------------------------------------------------

    const departmentData =
      await Department.findById(
        department
      ).lean();

    if (!departmentData) {
      return res.status(404).json({
        success: false,
        message:
          "Department not found",
      });
    }

    // --------------------------------------------------
    // 10. DEPARTMENT STATUS
    // --------------------------------------------------

    if (!departmentData.status) {
      return res.status(400).json({
        success: false,
        message:
          "Selected department is currently unavailable",
      });
    }

    // --------------------------------------------------
    // 11. DOCTOR-DEPARTMENT CHECK
    // --------------------------------------------------

    if (
      !doctorData.department ||
      normalizeId(
        doctorData.department
      ) !==
        normalizeId(
          departmentData._id
        )
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Selected doctor does not belong to this department",
      });
    }

    // --------------------------------------------------
    // 12. GET DOCTOR SLOTS
    // --------------------------------------------------

    const {
      dayName,
      availability,
      typeAvailability,
      slots: allSlots,
    } = getDoctorSlotsForDate({
      doctor: doctorData,
      appointmentDate:
        selectedDate,
      appointmentType,
    });

    // --------------------------------------------------
    // 13. NO DAY AVAILABILITY
    // --------------------------------------------------

    if (!availability) {
      return res.status(200).json({
        success: true,
        message:
          `Doctor is not available on ${dayName}`,
        doctorId:
          doctorData._id,
        departmentId:
          departmentData._id,
        appointmentType,
        appointmentDate:
          selectedDate,
        dayName,
        appointmentDuration:
          Number(
            doctorData.appointmentDuration
          ),
        totalSlots: 0,
        bookedSlots: [],
        availableSlots: [],
        isFull: true,
      });
    }

    // --------------------------------------------------
    // 14. TYPE NOT AVAILABLE
    // --------------------------------------------------

    if (
      !typeAvailability ||
      typeAvailability.enabled !== true
    ) {
      return res.status(200).json({
        success: true,
        message:
          `${appointmentType} consultation is not available on ${dayName}`,
        doctorId:
          doctorData._id,
        departmentId:
          departmentData._id,
        appointmentType,
        appointmentDate:
          selectedDate,
        dayName,
        appointmentDuration:
          Number(
            doctorData.appointmentDuration
          ),
        totalSlots: 0,
        bookedSlots: [],
        availableSlots: [],
        isFull: true,
      });
    }

    // --------------------------------------------------
    // 15. DURATION VALIDATION
    // --------------------------------------------------

    const appointmentDuration =
      Number(
        doctorData.appointmentDuration
      );

    if (
      !isValidDuration(
        appointmentDuration
      )
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Doctor appointment duration is not configured correctly",
      });
    }

    // --------------------------------------------------
    // 16. NO CONFIGURED SLOTS
    // --------------------------------------------------

    if (
      !Array.isArray(allSlots) ||
      allSlots.length === 0
    ) {
      return res.status(200).json({
        success: true,
        message:
          "No appointment slots configured for this date",
        doctorId:
          doctorData._id,
        departmentId:
          departmentData._id,
        appointmentType,
        appointmentDate:
          selectedDate,
        dayName,
        appointmentDuration,
        totalSlots: 0,
        bookedSlots: [],
        availableSlots: [],
        isFull: true,
      });
    }

    // --------------------------------------------------
    // 17. GET BOOKED APPOINTMENTS
    // --------------------------------------------------

    const bookedAppointments =
      await Appointment.find({
        doctor:
          doctorData._id,

        department:
          departmentData._id,

        appointmentType,

        appointmentDate:
          selectedDate,

        status:
          ACTIVE_APPOINTMENT_STATUSES,
      })
        .select(
          "startTime endTime status paymentStatus"
        )
        .lean();

    // --------------------------------------------------
    // 18. FILTER BOOKED SLOTS
    // --------------------------------------------------

    const bookedSlots = [];
    const availableSlots = [];

    for (
      const slot of allSlots
    ) {
      const slotStart =
        timeToMinutes(
          slot.startTime
        );

      const slotEnd =
        timeToMinutes(
          slot.endTime
        );

      const overlappingAppointment =
        bookedAppointments.find(
          (appointment) => {
            const bookedStart =
              timeToMinutes(
                appointment.startTime
              );

            const bookedEnd =
              timeToMinutes(
                appointment.endTime
              );

            return (
              slotStart <
                bookedEnd &&
              slotEnd >
                bookedStart
            );
          }
        );

      if (
        overlappingAppointment
      ) {
        bookedSlots.push({
          ...slot,
          status: "booked",
        });
      } else {
        availableSlots.push({
          ...slot,
          status: "available",
        });
      }
    }

    // --------------------------------------------------
    // 19. FINAL FULL CHECK
    // --------------------------------------------------

    const isFull =
      availableSlots.length === 0;

    // --------------------------------------------------
    // 20. RESPONSE
    // --------------------------------------------------

    return res.status(200).json({
      success: true,

      message: isFull
        ? "Appointment Full"
        : "Available slots fetched successfully",

      doctorId:
        doctorData._id,

      departmentId:
        departmentData._id,

      appointmentType,

      appointmentDate:
        selectedDate,

      dayName,

      appointmentDuration,

      totalSlots:
        allSlots.length,

      bookedSlots,

      availableSlots,

      availableCount:
        availableSlots.length,

      bookedCount:
        bookedSlots.length,

      isFull,
    });
  } catch (error) {
    console.error(
      "Get Available Appointment Slots Error:",
      error
    );

    if (
      error.name ===
      "CastError"
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Invalid ID provided",
      });
    }

    return res.status(500).json({
      success: false,
      message:
        error.message ||
        "Failed to fetch available appointment slots",
    });
  }
};

// ======================================================
// CREATE APPOINTMENT API
// ======================================================

const createAppointment = async (
  req,
  res
) => {
  try {
    if (!req.user?._id) {
      return res.status(401).json({
        success: false,
        message:
          "Authentication required",
      });
    }

    const appointment =
      await createAppointmentRecord({
        patientId:
          req.user._id,

        doctor:
          req.body.doctor,

        department:
          req.body.department,

        appointmentType:
          req.body.appointmentType,

        appointmentDate:
          req.body.appointmentDate,

        startTime:
          req.body.startTime,

        endTime:
          req.body.endTime,

        status:
          req.body.status ||
          "pending",

        paymentStatus:
          req.body.paymentStatus ||
          "unpaid",
      });

    return res.status(201).json({
      success: true,
      message:
        "Appointment created successfully",
      appointment,
    });
  } catch (error) {
    console.error(
      "Create Appointment Error:",
      error
    );

    if (error.statusCode) {
      return res.status(
        error.statusCode
      ).json({
        success: false,
        message:
          error.message,
      });
    }

    if (
      error.name ===
      "CastError"
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Invalid ID provided",
      });
    }

    if (
      error.name ===
      "ValidationError"
    ) {
      return res.status(400).json({
        success: false,
        message:
          Object.values(
            error.errors
          )
            .map(
              (err) =>
                err.message
            )
            .join(", "),
      });
    }

    return res.status(400).json({
      success: false,
      message:
        error.message ||
        "Failed to create appointment",
    });
  }
};

